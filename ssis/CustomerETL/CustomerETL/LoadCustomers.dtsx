            <component refId="Package\Load Customers Data Flow\Read Customer JSON" componentClassID="Microsoft.ManagedComponentHost" contactInfo="Includes and runs custom script code. For example, apply a business rule that limits the range of valid values in an &quot;income&quot; column or add values in two columns and calculate the average of the sum.;Microsoft Corporation; Microsoft SQL Server; Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;14" description="Includes and runs custom script code. For example, apply a business rule that limits the range of valid values in an &quot;income&quot; column or add values in two columns and calculate the average of the sum." name="Read Customer JSON" version="14">
              <properties>
                <property dataType="System.String" description="Stores the source code of the component" isArray="true" name="SourceCode" state="cdata">
                  <arrayElements arrayElementCount="30">
                    <arrayElement dataType="System.String"><![CDATA[main.cs]]></arrayElement>
                    <arrayElement dataType="System.String"><![CDATA[UTF8]]></arrayElement>
                    <arrayElement dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Text;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    private string src;
    private int pos;
    private string runId;

    public override void CreateNewOutputRows()
    {
        runId = DateTime.UtcNow.ToString("yyyyMMddHHmmssfffffff", CultureInfo.InvariantCulture) + "-" + Guid.NewGuid().ToString("N");
        var rows = ParseArrayOfObjects(File.ReadAllText(Variables.SourceFilePath));

        string[] dateFormats = { "yyyy-MM-dd", "yyyy/MM/dd", "yyyy-MM-dd'T'HH:mm:ss'Z'" };
        int n = 0;

        foreach (var r in rows)
        {
            n++;
            Output0Buffer.AddRow();
            Output0Buffer.SourceRowNum = n;
            Output0Buffer.RunID = runId;

            string raw = RawOf(r);
            Output0Buffer.RawRecord = raw.Length > 4000 ? raw.Substring(0, 4000) : raw;

            string s;
            if ((s = Get(r, "customer_id")) != null) Output0Buffer.CustomerID = s;
            else Output0Buffer.CustomerID_IsNull = true;

            if ((s = Get(r, "customer_name")) != null) Output0Buffer.CustomerName = s;
            else Output0Buffer.CustomerName_IsNull = true;

            if ((s = Get(r, "email")) != null) Output0Buffer.Email = s;
            else Output0Buffer.Email_IsNull = true;

            if ((s = Get(r, "region")) != null) Output0Buffer.Region = s;
            else Output0Buffer.Region_IsNull = true;

            DateTime dt;
            if ((s = Get(r, "join_date")) != null &&
                DateTime.TryParseExact(s, dateFormats, CultureInfo.InvariantCulture,
                                       DateTimeStyles.None, out dt))
                Output0Buffer.JoinDate = dt.Date;
            else
                Output0Buffer.JoinDate_IsNull = true;

            string loyaltyToken = GetToken(r, "loyalty_points");
            if (loyaltyToken == null)
            {
                Output0Buffer.LoyaltyPoints_IsNull = true; // JSON null is allowed; Derived Column defaults it to 0.
                Output0Buffer.LoyaltyPointsInvalid = false;
            }
            else
            {
                string rawNumber = loyaltyToken.StartsWith("N:", StringComparison.Ordinal) ? loyaltyToken.Substring(2) : null;
                long points;
                if (rawNumber != null && long.TryParse(rawNumber, NumberStyles.Integer,
                                                        CultureInfo.InvariantCulture, out points))
                {
                    Output0Buffer.LoyaltyPoints = points;
                    Output0Buffer.LoyaltyPointsInvalid = false;
                }
                else
                {
                    Output0Buffer.LoyaltyPoints_IsNull = true;
                    Output0Buffer.LoyaltyPointsInvalid = true;
                }
            }
        }
    }

    private static string GetToken(Dictionary<string, string> r, string key)
    {
        string v;
        return r.TryGetValue(key, out v) ? v : null;
    }

    private static string Get(Dictionary<string, string> r, string key)
    {
        string v = GetToken(r, key);
        return v == null ? null : (v.Length >= 2 && v[1] == ':' ? v.Substring(2) : v);
    }

    private static string RawOf(Dictionary<string, string> r)
    {
        var sb = new StringBuilder("{");
        bool first = true;
        foreach (var kv in r)
        {
            if (!first) sb.Append(", ");
            first = false;
            sb.Append('"').Append(kv.Key).Append("\": ");
            if (kv.Value == null) sb.Append("null");
            else if (kv.Value.Length >= 2 && (kv.Value[0] == 'N' || kv.Value[0] == 'B' || kv.Value[0] == 'J') && kv.Value[1] == ':')
                sb.Append(kv.Value.Substring(2));
            else
                sb.Append(QuoteJson(kv.Value.Substring(2)));
        }
        return sb.Append("}").ToString();
    }

    private static string QuoteJson(string value)
    {
        return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"")
                     .Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t") + "\"";
    }

    // ---- minimal JSON parser: array of flat objects ----
